import pandas as pd

# Dataset load karo (CSV file assume ki hai)
df = pd.read_csv("Housing.csv")

# 1️⃣ Maximum price based on hotwaterheating
max_price = df.groupby("hotwaterheating")["price"].max()

print("Maximum price based on hotwaterheating:\n")
print(max_price)


# 2️⃣ Rows jahan max price hai (both yes & no)
result = df.loc[df.groupby("hotwaterheating")["price"].idxmax()]

print("\nRows with maximum price in each category:\n")
print(result)
